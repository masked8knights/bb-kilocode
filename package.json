{
  "name": "bb-plugin-kilocode",
  "version": "0.1.3",
  "license": "MIT",
  "repository": "https://github.com/masked8knights/bb-kilocode",
  "description": "Kilo Code as a native BB provider — run BB threads on the kilo CLI over ACP.",
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Kilo Code",
    "description": "Run BB threads on Kilo Code.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo-light.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
